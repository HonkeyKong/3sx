<RamChecksum>
  <Range name="3sx-gameplay-telemetry"
         source="bus"
         cpuTag=":maincpu"
         space="program"
         offset="0x0C"
         size="0x24" />
</RamChecksum>

<MatchState enabled="true" mode="versus" winsRequired="2" rematchDelaySeconds="5">
  <Watch name="p1_wins" label="P1 Rounds Won" source="bus"
         cpuTag=":maincpu" space="program" offset="0x1C" size="1" />
  <Watch name="p2_wins" label="P2 Rounds Won" source="bus"
         cpuTag=":maincpu" space="program" offset="0x1D" size="1" />
  <Watch name="p1_score" label="P1 Score" source="bus"
         cpuTag=":maincpu" space="program" offset="0x14" size="4" />
  <Watch name="p2_score" label="P2 Score" source="bus"
         cpuTag=":maincpu" space="program" offset="0x18" size="4" />
  <Watch name="match_state" label="Match State" source="bus"
         cpuTag=":maincpu" space="program" offset="0x10" size="4" />
</MatchState>
